NODE_ENV=production
HOST=127.0.0.1
PORT=3001
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gongke
PGUSER=app_user
PGPASSWORD=<使用密码管理器生成的强密码>
IMAGE_ROOT=E:\lst-测试图片

# Cookie/CSRF/CORS：同源上线时只填网站 HTTPS origin
TRUSTED_ORIGINS=https://example.com
TRUST_PROXY=true
COOKIE_SECURE=true
SESSION_COOKIE_NAME=__Host-gk_session
SESSION_TTL_SECONDS=604800
IP_HASH_SECRET=<至少32字符随机密钥>

# Cloudflare Turnstile（生产必须启用）
TURNSTILE_PROVIDER=cloudflare
TURNSTILE_SECRET=<Cloudflare Turnstile secret>
# 前端构建时同时设置：VITE_TURNSTILE_SITE_KEY=<Cloudflare Turnstile site key>
TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_MS=5000

# 阿里云短信
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=<密钥>
ALIYUN_SMS_ACCESS_KEY_SECRET=<密钥>
ALIYUN_SMS_SIGN_NAME=<签名>
ALIYUN_SMS_TEMPLATE_CODE=<模板编号>
SMS_CODE_TTL=300
SMS_CODE_COOLDOWN=60

TERMS_VERSION=2026-10-28
PRIVACY_VERSION=2026-10-28
