# 依赖与构建产物
node_modules/
dist/
coverage/
playwright-report/
test-results/

# 后端构建产物与本地图片
server/dist/
/uploads/

# 本地包缓存与临时目录（含构建用 TMP）
.pnpm-store/
.tmp/
# 同义临时目录：不同工具/脚本会写成 _tmp、tmp，一并忽略，避免误提交
_tmp/
tmp/

# 本地数据库备份（含真实数据，绝不入库；备份由人工放在 backups/）
# 例外：backups/README.md 记录「这里该放什么、怎么恢复」，那份要入库
backups/*
!backups/README.md

# 本地环境
*.local
.env
.env.*
!.env.example

# 开发期自动生成的 JWT 签名密钥（生产环境必须用环境变量提供，见 server/src/lib/config.ts）
.jwt-secret

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
