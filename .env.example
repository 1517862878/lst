# ══════════════════════════════════════════════════════════════
# 工科影展 · 环境变量样例
#
# 用法：复制为 .env.local（本地开发）或 .env.production（构建用），再按需修改。
# 注意：.env 与 .env.* 均被 .gitignore 忽略，只有本文件会被提交。
#
# 两类变量的生效时机完全不同：
#   · VITE_ 前缀 → 「构建期」被 Vite 内联进 JS 产物，改了必须重新构建才生效；
#   · 其余       → 后端运行期读取（server/），只影响后端进程。
# ══════════════════════════════════════════════════════════════

# ── 前端（Vite 构建期）─────────────────────────────────────────
# 站点部署基路径：根域名用 /；子路径部署必须写成 /子路径/（前后都要有斜杠）。
# 与路由 basename 联动，写错会导致整站 404（见 src/app/router.tsx 注释）。
VITE_BASE=/

# 数据源：mock（浏览器本地演示数据，默认）| api（走后端 HTTP 接口）
VITE_DATA_SOURCE=api

# API 基址（只写「源」，不要写路径；接口路径本身已带 /api 前缀，见 src/data/api/*.ts）：
#   · 留空 = 同源模式：请求打向本站的 /api/*（推荐，由网关/Nginx 反代到后端，零 CORS）
#   · 本地联调后端（不使用下方 dev 代理时）可填 http://127.0.0.1:3001
VITE_API_BASE=

# 同源模式的显式开关：当 VITE_API_BASE 留空时，生产构建必须设成 1，否则构建会失败。
# 这是一条构建期断言（见 vite.config.ts），用于挡住「漏配 VITE_API_BASE」——
# 那会让线上访客的浏览器去请求访客自己的 127.0.0.1，表现为全站没有数据。
VITE_ALLOW_SAME_ORIGIN=1

# 可选：本地 dev 服务器把 /api/* 反代到哪个后端（默认 http://127.0.0.1:3001）
# VITE_DEV_API_TARGET=http://127.0.0.1:3001

# ── 后端（运行期，仅列变量名占位）──────────────────────────────
# ⚠️ 本文件会进版本库：以下值一律留空/占位，真实口令在部署时现场注入，不要提交。
# 上云建库时请直接生成新口令，让本机历史口令自然作废。

# 运行环境与端口
NODE_ENV=
PORT=

# PostgreSQL 连接（PGUSER 不要用 postgres —— superuser 会绕过全部 RLS 策略）
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# 图片文件存储根目录（留空即启动失败，不再静默指向某个本机目录）
IMAGE_ROOT=

# 允许跨域的前端来源白名单（同源反代部署时可不依赖它）
CORS_ORIGINS=

# 会话令牌签名与有效期
# JWT_SECRET 至少 32 个字符，不足启动即失败（HS256 密钥强度下限）；
#   生产环境必须显式提供，不允许自动生成落盘（云主机重建后密钥丢失 = 全员被登出且无报错）。
# JWT_TTL 单位为秒，默认 604800（7 天）。⚠️ 上云前必须改成 900（15 分钟）并补可撤销 refresh，
#   否则令牌一旦泄露没有任何止血手段（详见《上云优化方案》§2.3 与 ROADMAP 风险项 R-01）。
JWT_SECRET=
JWT_TTL=

# 短信通道（第 2 步手机号注册/登录用）
# 留空 = 开发模式：不真的发短信，验证码由接口在**非生产环境**直接返回；
# 上云前必须显式改成 aliyun，否则云端既收不到短信、也没有任何返回可看，
# 现象与「短信通道故障」完全无法区分。
SMS_PROVIDER=

# 验证码有效期（秒）与同一手机号的重发冷却（秒）
PHONE_CODE_TTL=
PHONE_CODE_COOLDOWN=

# 单个验证码最多可校验次数（上限与 20261027001300_auth_api.sql 保持一致）
PHONE_CODE_MAX_ATTEMPTS=
